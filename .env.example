OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-...
OLLAMA_API_KEY=none
GROQ_API_KEY=gsk_...
CEREBRAS_API_KEY=csk-...
NVIDIA_API_KEY=nvapi-...

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60        # requests per minute per IP
RATE_LIMIT_TPM=100000    # tokens per minute per IP (0 = disabled)

# Múltiples keys (rotación sin downtime)
API_KEYS=key-v1,key-v2


# Client Enviroments
LLM_PROXY_URL=http://localhost:8000/v1
LLM_PROXY_KEY=api-key-prueba
T1_CLIENT_ID=t1envios
T1_CLIENT_SECRET=<t1-secret>
T1_USERNAME=<email>
T1_PASSWORD=<password>
T1_ENV=<dev|prod>
T1_SHOP_ID=<get-from-t1>
T1_COMERCE_ID=<get-from-t1>